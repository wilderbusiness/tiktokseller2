# Copy to .env.local. Leave a group blank to keep that step disconnected.
# Missing keys stop the live call. Keel does not invent live numbers.

# TikTok Shop Open API
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# TikTok creator / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# direct sends a public init. Any other value uses the inbox draft upload.
TIKTOK_POST_MODE=inbox

# Shopify Admin API. Does not create the Shopify account.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Meta Marketing API. Campaigns are created paused.
# Activation refuses a daily budget above this cap.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_DAILY_BUDGET_CAP=

# Optional Alibaba Open Platform product search
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=

# Optional Temu seller API. There is no public buyer search.
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
